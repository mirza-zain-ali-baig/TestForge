# ─────────────────────────────────────────────
# ExamForge — Environment Variables Template
# ─────────────────────────────────────────────
# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Fill in the values below.
# 3. NEVER commit your actual ".env" file.

# Local SQLite Database (for saved tests)
# On Windows, use a relative path like: file:./db/custom.db
DATABASE_URL="file:./db/custom.db"

# Supabase (Question Bank — read-only access via anon key)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
